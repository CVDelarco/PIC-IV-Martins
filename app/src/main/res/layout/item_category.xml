<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="vertical">

    <!-- Cabeçalho do item: Nome, Valor e Porcentagem -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvCategoryName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Moradia" />

        <TextView
            android:id="@+id/tvCategoryPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:textColor="#6B7280"
            android:textSize="14sp"
            tools:text="51%" />

        <TextView
            android:id="@+id/tvCategoryValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@id/tvCategoryPercent"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="R$ 1.200,00" />
    </RelativeLayout>

    <!-- Barra de progresso visual -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressCategory"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        app:trackColor="#F3F4F6"
        app:trackCornerRadius="4dp"
        tools:progress="51" />

</LinearLayout>