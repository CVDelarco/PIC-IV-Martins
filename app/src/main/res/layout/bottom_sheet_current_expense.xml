<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Indicador de Arraste (Drag Handle) -->
        <View
            android:id="@+id/dragHandle"
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:background="#D1D5DB"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/current_expense_title"
            android:textColor="#111827"
            android:textSize="44sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnClose"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dragHandle" />

        <!-- Botão Fechar (X) -->
        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/close"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle"/>

        <!-- Card: Capturado Automática -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCaptured"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#E8EEF7"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Badge / Status Check -->
                <ImageView
                    android:id="@+id/icCheck"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/check"
                    app:tint="#255493"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvCapturedTag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/captured_automatically"
                    android:textColor="#255493"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/icCheck"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/icCheck"
                    app:layout_constraintTop_toTopOf="@id/icCheck" />

                <!-- Endereço Capturado -->
                <ImageView
                    android:id="@+id/icLocation"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/location"
                    app:tint="#255493"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvCapturedTag" />

                <TextView
                    android:id="@+id/tvCapturedAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/captured_address"
                    android:textColor="#374151"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="@id/icLocation"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/icLocation"
                    app:layout_constraintTop_toTopOf="@id/icLocation" />

                <!-- Coordenadas GPS -->
                <ImageView
                    android:id="@+id/icCoords"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/target"
                    app:tint="#255493"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/icLocation" />

                <TextView
                    android:id="@+id/tvCapturedCoords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/captured_coords"
                    android:textColor="#6B7280"
                    android:textSize="17sp"
                    app:layout_constraintBottom_toBottomOf="@id/icCoords"
                    app:layout_constraintStart_toEndOf="@id/icCoords"
                    app:layout_constraintTop_toTopOf="@id/icCoords" />

                <!-- Data e Hora Capturadas -->
                <ImageView
                    android:id="@+id/icTime"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/clock"
                    app:tint="#255493"
                    app:layout_constraintBottom_toBottomOf="@id/icCoords"
                    app:layout_constraintStart_toEndOf="@id/tvCapturedCoords"
                    app:layout_constraintTop_toTopOf="@id/icCoords" />

                <TextView
                    android:id="@+id/tvCapturedDateTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#6B7280"
                    android:textSize="17sp"
                    app:layout_constraintBottom_toBottomOf="@id/icTime"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/icTime"
                    app:layout_constraintTop_toTopOf="@id/icTime" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Campo Valor -->
        <TextView
            android:id="@+id/lblValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_value"
            android:textColor="#374151"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardCaptured" />

        <EditText
            android:id="@+id/etValue"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_expense_value_input"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblValue" />

        <!-- Forma de pagamento -->
        <TextView
            android:id="@+id/lblPaymentMethod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_payment_method"
            android:textColor="#374151"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etValue" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupPayment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:checkedButton="@id/btnPaymentCash"
            app:singleSelection="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblPaymentMethod">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPaymentCash"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="@string/payment_cash"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/selector_payment_button_bg"
                app:strokeColor="@color/selector_payment_button_text"
                android:textColor="@color/selector_payment_button_text"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPaymentPix"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="@string/payment_pix"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/selector_payment_button_bg"
                app:strokeColor="@color/selector_payment_button_text"
                android:textColor="@color/selector_payment_button_text"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPaymentDebit"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="@string/payment_debit"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/selector_payment_button_bg"
                app:strokeColor="@color/selector_payment_button_text"
                android:textColor="@color/selector_payment_button_text"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPaymentCredit"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="@string/payment_credit"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/selector_payment_button_bg"
                app:strokeColor="@color/selector_payment_button_text"
                android:textColor="@color/selector_payment_button_text" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Seção Parcelas -->
        <TextView
            android:id="@+id/lblInstallments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_installments"
            android:textColor="#374151"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toggleGroupPayment" />

        <LinearLayout
            android:id="@+id/layoutInstallments"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblInstallments">

            <!-- Botão Decrementar (-) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnMinusInstallment"
                android:layout_width="44dp"
                android:layout_height="50dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#D1D5DB"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="-"
                    android:textColor="#374151"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Texto Quantidade de Parcelas -->
            <TextView
                android:id="@+id/tvInstallmentsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:text="@string/placeholder_installments_count"
                android:textColor="#111827"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Botão Incrementar (+) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnPlusInstallment"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#D1D5DB"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="12dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="+"
                    android:textColor="#374151"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Valor Calculado da Parcela -->
            <TextView
                android:id="@+id/tvInstallmentsCalc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#6B7280"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Tipo e Subtipo -->
        <TextView
            android:id="@+id/lblType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:text="@string/label_type"
            android:textColor="#374151"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/lblSubtype"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutInstallments" />

        <TextView
            android:id="@+id/lblSubtype"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:text="@string/label_subtype"
            android:textColor="#374151"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/lblType"
            app:layout_constraintTop_toBottomOf="@id/layoutInstallments" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilType"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="#D1D5DB"
            app:boxStrokeWidth="1dp"
            app:hintEnabled="false"
            app:layout_constraintEnd_toStartOf="@id/tilSubtype"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblType">

            <AutoCompleteTextView
                android:id="@+id/actType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:text="Alimentação"
                android:textColor="#111827"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSubtype"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="#D1D5DB"
            app:boxStrokeWidth="1dp"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tilType"
            app:layout_constraintTop_toBottomOf="@id/lblSubtype">

            <AutoCompleteTextView
                android:id="@+id/actSubtype"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:text="Restaurante"
                android:textColor="#111827"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Descrição -->
        <TextView
            android:id="@+id/lblDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_description"
            android:textColor="#374151"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilType" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDescription"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxStrokeColor="#D1D5DB"
            app:boxStrokeWidth="1dp"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblDescription">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:textColor="#111827"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botões Inferiores -->
        <LinearLayout
            android:id="@+id/layoutButtons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilDescription">

            <!-- Botão Cancelar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:text="@string/btn_cancel"
                android:textAllCaps="false"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="#D1D5DB"
                app:strokeWidth="1dp" />

            <!-- Botão Salvar despesa -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveExpense"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1.6"
                android:backgroundTint="#B84A22"
                android:text="@string/btn_save_expense"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>